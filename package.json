{
  "name": "tessera-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": {
    "packages": ["packages/*", "apps/*"],
    "catalog": {
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "@types/node": "^26.6.6",
      "typescript": "^6.0.3",
      "typescript7": "npm:typescript@^7.0.2",
      "vitest": "^5.0.5"
    }
  },
  "scripts": {
    "check": "bun run typecheck && bun run lint && bun run build && bunx vitest run",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "eslint .",
    "build": "bun run --filter '*' build",
    "dev": "bun run --filter '*' --parallel dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.72.1",
    "vitest": "catalog:"
  }
}
