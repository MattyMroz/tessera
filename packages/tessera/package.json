{
  "name": "@mattymroz/tessera",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": ["dist", "docs"],
  "sideEffects": ["**/*.css"],
  "exports": {
    "./lib/*": {
      "source": "./src/lib/*.ts",
      "types": "./dist/lib/*.d.ts",
      "default": "./dist/lib/*.js"
    },
    "./tessera.css": {
      "source": "./src/styles/tessera.css",
      "default": "./dist/styles/tessera.css"
    },
    "./eslint": {
      "source": "./src/eslint/index.ts",
      "types": "./dist/eslint/index.d.ts",
      "default": "./dist/eslint/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "bun node_modules/typescript7/bin/tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "eslint": "^9 || ^10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3"
  },
  "peerDependenciesMeta": {
    "eslint": { "optional": true }
  },
  "devDependencies": {
    "@babel/core": "^8.0.10",
    "@rolldown/plugin-babel": "^0.3.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@typescript-eslint/parser": "8.72.1",
    "@typescript-eslint/rule-tester": "8.72.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.14.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.4",
    "typescript": "catalog:",
    "typescript7": "catalog:",
    "vitest": "catalog:"
  }
}
